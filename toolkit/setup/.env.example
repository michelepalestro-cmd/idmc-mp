# IDMC Toolkit credentials template: the keys the BLUEPRINTS need (Salesforce, Snowflake, Postgres, ...).
# Your IDMC login does NOT go here: it goes in IDMC_LOGIN.txt at the toolkit root (3 lines, nothing else to set up).
# Copy this file OUTSIDE the toolkit (default ~/.idmc_toolkit/.env), fill in the blueprint you build, and set
# IDMC_CREDS_FILE to its path. Never commit, zip or paste the filled-in copy. Scripts print key names, never values.
# setup/check_setup.py --demo <name> reads the "# [<name>]" section headers below.

# A key appears once even when several blueprints use it; later sections list it as '# KEY=   (also used here...)'.

# [optional]
# Session cache, login lock and block file folder (default ~/.idmc_session)
IDMC_CACHE_DIR=
# Cache name; use one per org when you work with more than one (default: hash of user + login host)
IDMC_PROFILE=
# Separate file written by Script Library/idmc_mcp.py when it creates an MCP OAuth client (holds IDMC_CLIENT_ID,
# IDMC_CLIENT_SECRET, IDMC_TOKEN_URL, MCP_BASE, IDMC_ORG_ID). Keep it outside the toolkit too.
IDMC_MCP_ENV_FILE=

# [retail_data_foundation]
# demos/retail_data_foundation: Retail Data Foundation (CDC, CDI, CAI, DQ, catalog)
# host name or address the Secure Agent uses to reach the stand-in Postgres - your docker host as seen from the agent
PG_HOST=
# Postgres port as seen from the agent (default 5432) - infra/docker-compose.yml port mapping
PG_PORT=
# source database name (default rdf_retail) - infra/docker-compose.yml POSTGRES_DB
PG_DB=
# application/owner role of the source database (default rdf_app) - infra/docker-compose.yml POSTGRES_USER
PG_USER=
# login secret of PG_USER - you choose it before `docker compose up`
PG_PASS=
# least-privilege replication role for Database Ingestion CDC (default rdf_cdc) - created by infra/sql/02_cdc_prereqs.sql
PG_CDC_USER=
# login secret of PG_CDC_USER - you choose it, passed to psql as a variable
PG_CDC_PASS=
# Google Cloud project id that holds the warehouse datasets - Google Cloud console project picker
BQ_PROJECT=
# path (outside the toolkit) to the service-account JSON key used by the BigQuery V2 connections - IAM > Service accounts > Keys
BQ_KEY_FILE=
# bucket name (no gs://) for BigQuery bulk loads and CDC staging - Cloud Storage > Buckets
GCS_STAGING_BUCKET=
# Salesforce My Domain base URL, https://<my-domain>.my.salesforce.com - Salesforce Setup > My Domain
SF_LOGIN_URL=
# consumer key of the Connected App (client-credentials flow) used by CAI - Setup > App Manager > your Connected App
SF_CLIENT_ID=
# consumer secret of that Connected App - same page (Manage Consumer Details)
SF_CLIENT_SECRET=
# API-only integration user for the CDI Salesforce connection - Setup > Users
SF_USERNAME=
# that user's login secret - set when you create the user
SF_PASSWORD=
# that user's security token (may be empty from a trusted IP range) - Salesforce personal settings > Reset Security Token
SF_SECURITY_TOKEN=
# optional: CAI runtime base URL of your org, https://<pod>-cai.<domain>.informaticacloud.com/active-bpel/public/rt/<orgIdV3> - printed by idmc/05_cai.py after publish
CAI_RT_BASE=

# [bid_desk_document_parsing]
# demos/bid_desk_document_parsing: Bid Desk (document parsing, DQ, Snowflake, Tableau)
# SF_INSTANCE_URL below is the same My Domain URL as SF_LOGIN_URL; a key listed as '# KEY=' is shared: set it once.
# SF_USERNAME=   (also used here: set it once, in the [retail_data_foundation] section above)
# SF_PASSWORD=   (also used here: set it once, in the [retail_data_foundation] section above)
# SF_SECURITY_TOKEN=   (also used here: set it once, in the [retail_data_foundation] section above)
# the org's My Domain URL, e.g. https://<mydomain>.my.salesforce.com - Salesforce Setup > My Domain
SF_INSTANCE_URL=
# SF_CLIENT_ID=   (also used here: set it once, in the [retail_data_foundation] section above)
# SF_CLIENT_SECRET=   (also used here: set it once, in the [retail_data_foundation] section above)
# Snowflake service user for IDMC (key-pair auth) - Snowflake: CREATE USER (infra/snowflake/01_cost_guard_and_access.sql)
SNOWFLAKE_USER=
# Snowflake programmatic access token for the SQL API (setup SQL, verify, feeds) - Snowsight > your user > Programmatic access tokens
SNOWFLAKE_PAT=
# read-only Snowflake user embedded in the Tableau data sources - Snowflake: CREATE USER with role BID_READER
SNOWFLAKE_BI_USER=
# that read-only user's login - set when you create the user
SNOWFLAKE_BI_PASSWORD=
# Microsoft Entra tenant id (GUID) - Entra admin center > Overview
ENTRA_TENANT_ID=
# application (client) id of the Entra app registration for IDMC SharePoint - Entra admin center > App registrations > your app > Overview
ENTRA_CLIENT_ID=
# a client secret of that app - Entra admin center > App registrations > your app > Certificates & secrets
ENTRA_CLIENT_SECRET=
# delegated refresh token minted for the SharePoint audience (not Graph), after admin consent - infra/sharepoint_setup.py token-url, sign in once, redeem the code (BUILD step 5)
SHAREPOINT_REFRESH_TOKEN=
# Tableau personal access token name - Tableau: My Account Settings > Personal Access Tokens
TABLEAU_PAT_NAME=
# Tableau personal access token secret - same page (shown once)
TABLEAU_PAT_SECRET=

# [message_bus_kafka_cai]
# demos/message_bus_kafka_cai: Message Bus Replacement (Kafka + CAI)
# Postgres superuser name for the stand-in ops ledger container (mbr-pg) - you choose it before `docker compose up`
MBR_PG_USER=
# that Postgres user's password - you choose it (generate a long random string)
MBR_PG_PASSWORD=
# password of the login role `mbr_api_login` that PostgREST uses (created by infra/postgres SQL) - you choose it
MBR_PGRST_AUTH_PASSWORD=
# password of the read-only role `mbr_batch_reader` that the IDMC PostgreSQL connection uses - you choose it
MBR_CDI_PG_PASSWORD=
# ActiveMQ Artemis user for the legacy JMS stand-in and the CAI AMQP connection - you choose it
MBR_ARTEMIS_USER=
# that Artemis user's password (set into CAI with asset/v1/update, never in a package) - you choose it
MBR_ARTEMIS_PASSWORD=
# SYS/SYSTEM password of the Oracle Free container (mbr-oracle) - you choose it
MBR_ORACLE_PASSWORD=
# password of the Oracle schema user MBR_BATCH (the nightly CDI target) - you choose it
MBR_ORACLE_BATCH_PASSWORD=
# KRaft cluster id (22-char base64 UUID) - generate once: `docker run --rm apache/kafka:4.3.1 /opt/kafka/bin/kafka-storage.sh random-uuid`
MBR_KAFKA_CLUSTER_ID=
