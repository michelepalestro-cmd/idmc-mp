{
 "name": "${idmc.project} - 1 CRM Bid Documents",
 "status": "PROVEN (2026-10-13, same shape); toolkit/mapgen build ADAPTED (compiles offline; not yet imported in this form)",
 "description": "BRONZE, 2 flows, Salesforce connector: the agencies (Account) -> Snowflake; every version of every bid document attached to them (Files = ContentVersion, PDF bytes as base64) -> read before? (Lookup) -> only new versions (Filter) -> the agency (Lookup) -> document type + solicitation number from the title (Expression) -> Snowflake.",
 "task": {
  "folder": "f1",
  "runtime": "crm"
 },
 "notes": [
  "soqlFilters: the SOQL WHERE of each Salesforce source (readOptions.filterCondition, L-CONN-108); bid_mappings.py writes it, with the Salesforce data-object attributes owner / resource, at build time",
  "SRC_CRM_BID_FILES: a PLAIN id list: FirstPublishLocationId is set on version 1 only (L-CONN-114), and the catalog cannot parse a sub-query filter, so a sub-query drops ContentVersion from lineage",
  "SRC_CRM_BID_FILES.CreatedDate: a Salesforce datetime source field validates at precision 24, scale 0 (L-CDI-245)"
 ],
 "soqlFilters": {
  "SRC_CRM_AGENCY": "Name IN (${state:crm.agency_name_list})",
  "SRC_CRM_BID_FILES": "ContentDocumentId IN (${state:crm.content_document_id_list})"
 },
 "nodes": [
  {
   "type": "source",
   "name": "SRC_CRM_AGENCY",
   "conn": "CRM",
   "object": "Account",
   "fields": [
    [
     "Id",
     "STRING",
     18,
     "id"
    ],
    [
     "Name",
     "STRING",
     255,
     "string"
    ],
    [
     "Type",
     "STRING",
     255,
     "picklist"
    ]
   ]
  },
  {
   "type": "expression",
   "name": "EXP_AGENCY_FIELDS",
   "fields": [
    {
     "name": "x_run",
     "type": "STRING",
     "expr": "TO_CHAR(SESSSTARTTIME, 'YYYYMMDDHH24MISS')",
     "prec": 20
    },
    {
     "name": "x_ts",
     "type": "TIMESTAMP",
     "expr": "SESSSTARTTIME"
    },
    {
     "name": "x_src",
     "type": "STRING",
     "expr": "'Salesforce'",
     "prec": 40
    }
   ]
  },
  {
   "type": "target",
   "name": "TGT_BRZ_SF_AGENCY",
   "conn": "WH",
   "object": "${snowflake.database}/${snowflake.schema}/BID_BRZ_SF_AGENCY",
   "op": "Insert",
   "fields": [
    [
     "ID",
     "STRING",
     18,
     "varchar"
    ],
    [
     "NAME",
     "STRING",
     255,
     "varchar"
    ],
    [
     "ACCOUNT_TYPE",
     "STRING",
     40,
     "varchar"
    ],
    [
     "SF_SOURCE",
     "STRING",
     40,
     "varchar"
    ],
    [
     "IDMC_RUN_ID",
     "STRING",
     20,
     "varchar"
    ],
    [
     "LOADED_AT",
     "TIMESTAMP",
     null,
     "timestampntz"
    ]
   ]
  },
  {
   "type": "source",
   "name": "SRC_CRM_BID_FILES",
   "conn": "CRM",
   "object": "ContentVersion",
   "fields": [
    [
     "Id",
     "STRING",
     18,
     "id"
    ],
    [
     "ContentDocumentId",
     "STRING",
     18,
     "reference"
    ],
    [
     "FirstPublishLocationId",
     "STRING",
     18,
     "reference"
    ],
    [
     "Title",
     "STRING",
     255,
     "string"
    ],
    [
     "PathOnClient",
     "STRING",
     500,
     "string"
    ],
    [
     "FileExtension",
     "STRING",
     40,
     "string"
    ],
    [
     "VersionNumber",
     "STRING",
     20,
     "string"
    ],
    [
     "ContentSize",
     "INTEGER",
     null,
     "int"
    ],
    [
     "Checksum",
     "STRING",
     50,
     "string"
    ],
    [
     "CreatedDate",
     "TIMESTAMP",
     24,
     "datetime",
     0
    ],
    [
     "ReasonForChange",
     "STRING",
     1000,
     "string"
    ],
    [
     "VersionData",
     "STRING",
     7340032,
     "base64"
    ]
   ]
  },
  {
   "type": "lookup",
   "name": "LKP_READ_BEFORE",
   "connected": true,
   "conn": "WH",
   "query": "SELECT CONTENT_VERSION_ID AS \"lr_cv\", MAX(IDMC_RUN_ID) AS \"lr_run\" FROM ${snowflake.database}.${snowflake.schema}.BID_BRZ_SF_DOCUMENT GROUP BY 1",
   "cond": [
    [
     "lr_cv",
     "Id"
    ]
   ],
   "policy": "Use Any Value",
   "fields": [
    [
     "lr_cv",
     "STRING",
     18,
     "varchar"
    ],
    [
     "lr_run",
     "STRING",
     20,
     "varchar"
    ]
   ]
  },
  {
   "type": "filter",
   "name": "FIL_NEW_VERSIONS",
   "cond": "ISNULL(lr_cv)"
  },
  {
   "type": "lookup",
   "name": "LKP_AGENCY",
   "connected": true,
   "conn": "WH",
   "query": "SELECT ID AS \"la_id\", NAME AS \"la_name\" FROM ${snowflake.database}.${snowflake.schema}.BID_BRZ_SF_AGENCY QUALIFY IDMC_RUN_ID = MAX(IDMC_RUN_ID) OVER ()",
   "cond": [
    [
     "la_id",
     "FirstPublishLocationId"
    ]
   ],
   "policy": "Use Any Value",
   "fields": [
    [
     "la_id",
     "STRING",
     18,
     "varchar"
    ],
    [
     "la_name",
     "STRING",
     255,
     "varchar"
    ]
   ]
  },
  {
   "type": "expression",
   "name": "EXP_DOCUMENT_FIELDS",
   "fields": [
    {
     "name": "x_run",
     "type": "STRING",
     "expr": "TO_CHAR(SESSSTARTTIME, 'YYYYMMDDHH24MISS')",
     "prec": 20
    },
    {
     "name": "x_ts",
     "type": "TIMESTAMP",
     "expr": "SESSSTARTTIME"
    },
    {
     "name": "x_src",
     "type": "STRING",
     "expr": "'Salesforce'",
     "prec": 40
    },
    {
     "name": "x_type",
     "type": "STRING",
     "prec": 40,
     "expr": "IIF(INSTR(UPPER(Title), 'BID PACKET') > 0, 'Bid packet', IIF(INSTR(UPPER(Title), 'SIGNATURE PAGE') > 0, 'Signature page', 'Other'))"
    },
    {
     "name": "x_solicitation",
     "type": "STRING",
     "prec": 40,
     "expr": "REG_EXTRACT(Title, '^([0-9A-Z]+(-[0-9A-Z]+)+).*', 1)"
    }
   ]
  },
  {
   "type": "target",
   "name": "TGT_BRZ_SF_DOCUMENT",
   "conn": "WH",
   "object": "${snowflake.database}/${snowflake.schema}/BID_BRZ_SF_DOCUMENT",
   "op": "Insert",
   "fields": [
    [
     "CONTENT_VERSION_ID",
     "STRING",
     18,
     "varchar"
    ],
    [
     "CONTENT_DOCUMENT_ID",
     "STRING",
     18,
     "varchar"
    ],
    [
     "AGENCY_ID",
     "STRING",
     18,
     "varchar"
    ],
    [
     "AGENCY",
     "STRING",
     255,
     "varchar"
    ],
    [
     "TITLE",
     "STRING",
     255,
     "varchar"
    ],
    [
     "FILE_NAME",
     "STRING",
     500,
     "varchar"
    ],
    [
     "FILE_EXTENSION",
     "STRING",
     40,
     "varchar"
    ],
    [
     "VERSION_NUMBER",
     "STRING",
     20,
     "varchar"
    ],
    [
     "CONTENT_SIZE",
     "INTEGER",
     12,
     "number",
     0
    ],
    [
     "CHECKSUM",
     "STRING",
     50,
     "varchar"
    ],
    [
     "SF_CREATED_AT",
     "TIMESTAMP",
     null,
     "timestampntz"
    ],
    [
     "REASON_FOR_CHANGE",
     "STRING",
     1000,
     "varchar"
    ],
    [
     "DOC_TYPE",
     "STRING",
     40,
     "varchar"
    ],
    [
     "SOLICITATION_NO",
     "STRING",
     40,
     "varchar"
    ],
    [
     "CONTENT_B64",
     "STRING",
     7340032,
     "varchar"
    ],
    [
     "SF_SOURCE",
     "STRING",
     40,
     "varchar"
    ],
    [
     "IDMC_RUN_ID",
     "STRING",
     20,
     "varchar"
    ],
    [
     "LOADED_AT",
     "TIMESTAMP",
     null,
     "timestampntz"
    ]
   ]
  }
 ],
 "links": [
