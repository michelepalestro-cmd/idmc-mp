{
 "name": "m_ex_type_fidelity",
 "description": "[mapgen-suite S10] Type round-trip diagnostic: unicode, 255-char text, empty vs NULL, quotes and embedded newlines, NUMERIC at scale 9, 64-bit integers above 2^53, doubles, booleans, microsecond timestamps and DATE columns read and written.",
 "nodes": [
  {
   "type": "source",
   "name": "SRC_TYPES",
   "conn": "BQ",
   "query": "SELECT id AS src_id, s_unicode AS src_s_unicode, s_long AS src_s_long, s_empty AS src_s_empty, s_quote AS src_s_quote, n_dec AS src_n_dec, i_big AS src_i_big, f_val AS src_f_val, b_flag AS src_b_flag, ts_micro AS src_ts_micro, CAST(d_date AS TIMESTAMP) AS src_d_date, s_emoji AS src_s_emoji FROM `${BQ_PROJECT}.${DATASET}.type_edges`",
   "fields": [
    [
     "src_id",
     "INTEGER"
    ],
    [
     "src_s_unicode",
     "STRING",
     256
    ],
    [
     "src_s_long",
     "STRING",
     256
    ],
    [
     "src_s_empty",
     "STRING",
     256
    ],
    [
     "src_s_quote",
     "STRING",
     256
    ],
    [
     "src_n_dec",
     "NUMERIC"
    ],
    [
     "src_i_big",
     "INTEGER"
    ],
    [
     "src_f_val",
     "FLOAT"
    ],
    [
     "src_b_flag",
     "BOOLEAN"
    ],
    [
     "src_ts_micro",
     "TIMESTAMP"
    ],
    [
     "src_d_date",
     "TIMESTAMP"
    ],
    [
     "src_s_emoji",
     "STRING",
     256
    ]
   ]
  },
  {
   "type": "expression",
   "name": "EXP_TYPES",
   "fields": [
