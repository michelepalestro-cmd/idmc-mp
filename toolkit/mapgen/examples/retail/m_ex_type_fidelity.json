     "kind": "OUTPUT"
    },
    {
     "name": "b_str",
     "type": "STRING",
     "expr": "src_b_flag",
     "kind": "OUTPUT",
     "prec": 10
    },
    {
     "name": "ts_micro",
     "type": "TIMESTAMP",
     "expr": "src_ts_micro",
     "kind": "OUTPUT"
    },
    {
     "name": "d_date",
     "type": "STRING",
     "expr": "TO_CHAR(src_d_date, 'YYYY-MM-DD') || ' 00:00:00'",
     "kind": "OUTPUT",
     "prec": 19
    },
    {
     "name": "s_emoji",
     "type": "STRING",
     "expr": "src_s_emoji",
     "kind": "OUTPUT",
     "prec": 256
    },
    {
     "name": "s_upper",
     "type": "STRING",
     "expr": "UPPER(src_s_unicode)",
     "kind": "OUTPUT",
     "prec": 256
    },
    {
     "name": "s_len",
     "type": "INTEGER",
     "expr": "LENGTH(src_s_unicode)",
     "kind": "OUTPUT"
    },
    {
     "name": "empty_kind",
     "type": "STRING",
     "expr": "IIF(ISNULL(src_s_empty), 'NULL', IIF(src_s_empty = '', 'EMPTY', 'VALUE'))",
     "kind": "OUTPUT",
     "prec": 8
    },
    {
     "name": "quoted",
     "type": "STRING",
     "expr": "CHR(39) || src_s_quote || CHR(39)",
     "kind": "OUTPUT",
     "prec": 256
    },
    {
     "name": "n_plus",
     "type": "NUMERIC",
     "expr": "src_n_dec + 1",
     "kind": "OUTPUT"
    },
    {
     "name": "i_plus",
     "type": "INTEGER",
     "expr": "src_i_big + 1",
     "kind": "OUTPUT"
    },
    {
     "name": "ts_str",
     "type": "STRING",
     "expr": "TO_CHAR(src_ts_micro, 'YYYY-MM-DD HH24:MI:SS.US')",
     "kind": "OUTPUT",
     "prec": 32
    },
    {
     "name": "d_str",
     "type": "STRING",
     "expr": "TO_CHAR(src_d_date, 'YYYY-MM-DD')",
     "kind": "OUTPUT",
     "prec": 10
    }
   ]
