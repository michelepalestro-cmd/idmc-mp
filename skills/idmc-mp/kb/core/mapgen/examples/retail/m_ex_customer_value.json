{
 "name": "m_ex_customer_value",
 "description": "[mapgen-suite S03] Customer value: two stacked Aggregators (distinct-store count without COUNT DISTINCT), conditional aggregates, an inner Joiner, an unconnected Lookup for the home region, date maths, and Rank top 5 per region.",
 "nodes": [
  {
   "type": "source",
   "name": "SRC_ORDERS",
   "conn": "BQ",
   "query": "SELECT order_id, customer_id, store_id, channel, order_ts, status, order_total FROM `${BQ_PROJECT}.${DATASET}.orders`",
   "fields": [
    [
     "order_id",
     "STRING",
     256
    ],
    [
     "customer_id",
     "STRING",
     256
    ],
    [
     "store_id",
     "STRING",
     256
    ],
    [
     "channel",
     "STRING",
     256
    ],
    [
     "order_ts",
     "TIMESTAMP"
    ],
    [
     "status",
     "STRING",
     256
    ],
    [
     "order_total",
     "NUMERIC"
    ]
   ]
  },
  {
   "type": "filter",
   "name": "FIL_KNOWN",
   "cond": "NOT ISNULL(customer_id) AND status != 'CANCELLED'"
  },
  {
   "type": "aggregator",
   "name": "AGG_CUST_STORE",
   "groupBy": [
    "customer_id",
    "store_id"
   ],
   "fields": [
    {
     "name": "cs_orders",
     "type": "INTEGER",
     "expr": "COUNT(order_id)"
    },
    {
     "name": "cs_spend",
     "type": "NUMERIC",
     "expr": "SUM(order_total)"
    },
    {
     "name": "cs_refund",
     "type": "NUMERIC",
     "expr": "SUM(order_total, order_total < 0)"
    },
    {
     "name": "cs_online",
     "type": "INTEGER",
     "expr": "COUNT(order_id, channel != 'POS')"
    },
    {
     "name": "cs_first",
     "type": "TIMESTAMP",
     "expr": "MIN(order_ts)"
    },
    {
     "name": "cs_last",
     "type": "TIMESTAMP",
     "expr": "MAX(order_ts)"
    },
    {
     "name": "cs_max",
     "type": "NUMERIC",
     "expr": "MAX(order_total)"
    }
   ]
  },
  {
   "type": "aggregator",
   "name": "AGG_CUSTOMER",
   "groupBy": [
    "customer_id"
   ],
   "fields": [
    {
     "name": "distinct_stores",
     "type": "INTEGER",
     "expr": "COUNT(store_id)"
    },
    {
     "name": "orders",
     "type": "INTEGER",
     "expr": "SUM(cs_orders)"
    },
    {
     "name": "total_spend",
     "type": "NUMERIC",
     "expr": "SUM(cs_spend)"
    },
    {
     "name": "refund_sum",
     "type": "NUMERIC",
     "expr": "SUM(cs_refund)"
    },
    {
     "name": "online_orders",
     "type": "INTEGER",
     "expr": "SUM(cs_online)"
    },
    {
     "name": "first_order_ts",
     "type": "TIMESTAMP",
     "expr": "MIN(cs_first)"
    },
    {
     "name": "last_order_ts",
     "type": "TIMESTAMP",
     "expr": "MAX(cs_last)"
    },
    {
     "name": "max_order",
     "type": "NUMERIC",
     "expr": "MAX(cs_max)"
    }
   ]
  },
  {
   "type": "source",
   "name": "SRC_HOME",
   "conn": "BQ",
   "query": "SELECT customer_id AS h_customer_id, home_store_id AS h_home_store_id FROM `${BQ_PROJECT}.${DATASET}.customers`",
   "fields": [
    [
     "h_customer_id",
     "STRING",
     256
    ],
    [
     "h_home_store_id",
     "STRING",
     256
    ]
   ]
  },
  {
   "type": "joiner",
   "name": "JNR_HOME",
   "master": "SRC_HOME",
   "detail": "AGG_CUSTOMER",
   "cond": [
    [
     "h_customer_id",
     "customer_id"
    ]
   ],
   "join": "NORMAL"
  },
  {
   "type": "lookup",
   "name": "LKP_REGION",
   "conn": "BQ",
   "query": "SELECT store_id AS lk_store_id, region AS lk_region FROM `${BQ_PROJECT}.${DATASET}.stores`",
   "fields": [
    [
     "lk_store_id",
     "STRING",
     64
    ],
    [
     "lk_region",
     "STRING",
     64
    ]
   ],
   "cond": [
    [
     "lk_store_id",
     "IN_store_id"
    ]
   ],
   "ret": "lk_region"
  },
  {
   "type": "expression",
   "name": "EXP_RFM",
   "fields": [
    {
     "name": "v_region",
     "type": "STRING",
     "expr": ":LKP.LKP_REGION(h_home_store_id)",
     "kind": "VARIABLE",
     "prec": 16
    },
    {
     "name": "v_days",
     "type": "INTEGER",
     "expr": "TO_INTEGER(DATE_DIFF(TO_DATE('2026-06-30 00:00:00', 'YYYY-MM-DD HH24:MI:SS'), last_order_ts, 'DD'), TRUE)",
     "kind": "VARIABLE"
    },
    {
     "name": "region",
     "type": "STRING",
     "expr": "IIF(ISNULL(v_region), 'UNKNOWN', v_region)",
     "kind": "OUTPUT",
     "prec": 16
    },
    {
     "name": "refund_total",
     "type": "NUMERIC",
     "expr": "IIF(ISNULL(refund_sum), 0, refund_sum)",
     "kind": "OUTPUT"
    },
    {
     "name": "avg_order",
     "type": "NUMERIC",
     "expr": "ROUND(total_spend / orders, 6)",
     "kind": "OUTPUT"
    },
    {
     "name": "recency_days",
     "type": "INTEGER",
     "expr": "v_days",
     "kind": "OUTPUT"
    },
    {
     "name": "tenure_days",
     "type": "INTEGER",
     "expr": "TO_INTEGER(DATE_DIFF(last_order_ts, first_order_ts, 'DD'), TRUE)",
     "kind": "OUTPUT"
    },
    {
     "name": "segment",
     "type": "STRING",
     "expr": "DECODE(TRUE, v_days <= 30 AND orders >= 5, 'CHAMPION', v_days <= 45 AND total_spend >= 500, 'LOYAL', v_days > 90, 'AT_RISK', total_spend < 0, 'NET_REFUND', 'REGULAR')",
     "kind": "OUTPUT",
     "prec": 16
    }
   ]
  },
  {
   "type": "rank",
   "name": "RNK_TOP5",
   "by": "total_spend",
   "top": true,
   "n": 5,
   "groupBy": [
    "region"
   ]
  },
  {
   "type": "expression",
   "name": "EXP_RANK",
   "fields": [
    {
     "name": "rank_in_region",
     "type": "INTEGER",
     "expr": "RANKINDEX",
     "kind": "OUTPUT"
    }
   ]
  },
  {
   "type": "target",
   "name": "TGT_CUSTOMER_VALUE",
   "conn": "BQ",
   "object": "${DATASET}/out_customer_value",
   "truncate": true,
   "fields": [
    [
     "customer_id",
     "STRING"
    ],
    [
     "region",
     "STRING"
    ],
    [
     "orders",
     "INTEGER"
    ],
    [
     "distinct_stores",
     "INTEGER"
    ],
    [
     "total_spend",
     "NUMERIC"
    ],
    [
     "refund_total",
     "NUMERIC"
    ],
    [
     "online_orders",
     "INTEGER"
    ],
    [
     "max_order",
     "NUMERIC"
    ],
    [
     "avg_order",
     "NUMERIC"
    ],
    [
     "first_order_ts",
     "TIMESTAMP"
    ],
    [
     "last_order_ts",
     "TIMESTAMP"
    ],
    [
     "recency_days",
     "INTEGER"
    ],
    [
     "tenure_days",
     "INTEGER"
    ],
    [
     "segment",
     "STRING"
    ]
   ],
   "oprAttrs": {
    "jobPollInterval": "1",
    "pollInterval": "1"
   },
   "rtAttrs": {
    "Job Poll Interval In Seconds": "1"
   }
  },
  {
   "type": "target",
   "name": "TGT_TOP_CUSTOMERS",
   "conn": "BQ",
   "object": "${DATASET}/out_top_customers",
   "truncate": true,
   "fields": [
    [
     "region",
     "STRING"
    ],
    [
     "rank_in_region",
     "INTEGER"
    ],
    [
     "customer_id",
     "STRING"
    ],
    [
     "total_spend",
     "NUMERIC"
    ],
    [
     "orders",
     "INTEGER"
    ]
   ],
   "oprAttrs": {
    "jobPollInterval": "1",
    "pollInterval": "1"
   },
   "rtAttrs": {
    "Job Poll Interval In Seconds": "1"
   }
  }
 ],
 "links": [
  [
   "SRC_ORDERS",
   "FIL_KNOWN"
  ],
  [
   "FIL_KNOWN",
   "AGG_CUST_STORE"
  ],
  [
   "AGG_CUST_STORE",
   "AGG_CUSTOMER"
  ],
  [
   "SRC_HOME",
   "JNR_HOME.Master"
  ],
  [
   "AGG_CUSTOMER",
   "JNR_HOME.Detail"
  ],
  [
   "JNR_HOME",
   "EXP_RFM"
  ],
  [
   "EXP_RFM",
   "TGT_CUSTOMER_VALUE"
  ],
  [
   "EXP_RFM",
   "RNK_TOP5"
  ],
  [
   "RNK_TOP5",
   "EXP_RANK"
  ],
  [
   "EXP_RANK",
   "TGT_TOP_CUSTOMERS"
  ]
 ]
}
