    },
    {
     "name": "o_email",
     "type": "STRING",
     "prec": 10,
     "expr": "IIF(ISNULL(EMAIL_VALUE), NULL, Output)"
    },
    {
     "name": "x_status",
     "type": "STRING",
     "prec": 20,
     "expr": "IIF(o_filled = 'INVALID', 'BLANK', IIF(NOT ISNULL(EMAIL_VALUE) AND Output = 'INVALID', 'INVALID', 'OK'))"
