     "idmc-api.dm-<region>.informaticacloud.com",
     "data360/*, marketplace, MDM control"
    ],
    [
     "CDGC write plane",
     "same three-header flow",
     "Bearer + IDS-SESSION-ID + X-INFA-ORG-ID",
     "cdgc-api.dm-us.informaticacloud.com",
     "ccgf-*, cdmp-marketplace"
    ],
    [
     "CAI runtime",
     "v3 session",
     "INFA-SESSION-ID (+ vnd.api+json to publish)",
     "<pod>-cai.dm-us.informaticacloud.com",
     "/active-bpel/*"
    ],
    [
     "MDM runtime",
     "three-header flow",
     "Bearer + IDS-SESSION-ID + X-INFA-ORG-ID",
     "<pod>-mdm.dm-us.informaticacloud.com",
     "business-entity/public/api/v1/*"
    ],
    [
     "CDQ dictionaries",
     "either method",
     "Bearer JWT or IDS-SESSION-ID",
     "<pod>-dqcloud-api.dm-us.informaticacloud.com",
     "/quality/public/v2/*"
    ],
    [
     "Data Profiling",
     "SPA session",
     "IDS-SESSION-ID, SPA-injected",
     "<pod>-dqprofile.dm-us.informaticacloud.com",
     "profiling-service, metric-store"
    ],
    [
     "MCP servers",
     "three options",
     "IDS-SESSION-ID | Bearer JWT | OAuth2 client credentials",
     "a2e-prod-<pod>-mcp.dm-us.informaticacloud.com",
     "/mcp-servers/public/*"
    ],
    [
     "Anonymous CAI",
     "none",
     "none",
     "<pod>-cai.dm-us.informaticacloud.com",
     "/active-bpel/public/rt/*"
    ]
